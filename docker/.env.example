# Copy to `.env` (next to the compose file) before `docker compose ... up -d`.
# `.env` is gitignored; this example is safe to commit.

# Required: shared secret the edge agents / API callers use (require_any_token).
AGENT_MESH_TOKEN=change-me-to-a-long-random-secret

# Host port the Web UI / REST API is published on.
AGENT_MESH_PORT=8000

# Image tag built by ./docker/build.sh.
AGENT_MESH_IMAGE=agent-mesh:local

# Existing installations must use the PostgreSQL user's current password.
POSTGRES_USER=agent_mesh
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=agent_mesh

# The PostgreSQL 16 volume must exist before first startup. Backups are saved
# outside these volumes, under /opt/agent-mesh/backups by default.
AGENT_MESH_PG_VOLUME=agent-mesh-pg-data
AGENT_MESH_DATA_DIR=/opt/agent-mesh/data
# Default container user 0:0 can write an existing root-owned data directory.
# AGENT_MESH_CONTAINER_USER=0:0
# Reuse the original PostgreSQL 16 image when adopting a populated volume.
# AGENT_MESH_POSTGRES_IMAGE=postgres:16
