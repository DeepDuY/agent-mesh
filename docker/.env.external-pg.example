# Copy to `.env` (next to this file) for docker-compose.external-pg.yml.
# Use this when Postgres already exists (an existing container / host / remote)
# and you only want to run the orchestrator in a container.
# `.env` is gitignored; this example is safe to commit.

# Required.
AGENT_MESH_TOKEN=change-me-to-the-same-secret-as-before
AGENT_MESH_PG_DSN=postgresql://agent_mesh:password@127.0.0.1:5432/agent_mesh

# Host port the Web UI / REST API is published on (host networking).
AGENT_MESH_PORT=8000

# Image tag built by ../build.sh.
AGENT_MESH_IMAGE=agent-mesh:local

# Host directory holding artifacts / files / skills / bootstrap (bind-mounted
# to /data). Defaults to the standard systemd layout.
AGENT_MESH_DATA_DIR=/opt/agent-mesh/data

# Optional: container user (default 0:0 = root, so a root-owned data dir works).
# AGENT_MESH_CONTAINER_USER=0:0
